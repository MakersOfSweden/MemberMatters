{
  "name": "membermatters",
  "version": "3.8.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "scripts": {
    "prepare": "husky && pip3 install black",
    "pre-commit": "lint-staged --hide-unstaged"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "echo Linting Frontend",
      "npm run lint:precommit --prefix src-frontend -- "
    ],
    "*.py": [
      "echo Linting Backend",
      "black"
    ]
  }
}
