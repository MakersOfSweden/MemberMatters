{
  "name": "frontend",
  "version": "4.0.0",
  "description": "The MemberMatters frontend",
  "productName": "MemberMatters",
  "author": "Jaimyn Mayer <github@jaimyn.dev>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "predev:electron": "npm install --prefix src-electron",
    "dev:electron": "quasar dev -m electron",
    "build": "quasar build -m spa",
    "prebuild:electron": "npm ci --prefix src-electron",
    "build:electron": "quasar build -m electron",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "lint": "npm run format && eslint --cache --fix --ext .js,.vue,.ts ./",
    "lint:check": "npm run format:check && eslint --ext .js,.vue,.ts ./",
    "lint:precommit": "npm run format && eslint --ext .js,.ts,.vue ./",
    "test": "quasar prepare && vitest run",
    "test:watch": "quasar prepare && vitest watch",
    "icons": "icongenie generate -i app-icon.png"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@stripe/stripe-js": "^5.10.0",
    "address": "^1.1.2",
    "apexcharts": "^5.10.0",
    "axios": "^1.20.0",
    "crypto-js": "^4.1.1",
    "csv-stringify": "^6.9.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "idle-timeout": "^2.6.0",
    "libphonenumber-js": "^1.13.14",
    "node-stdlib-browser": "^1.2.0",
    "qrcode": "^1.5.4",
    "quasar": "^2.34.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vue3-apexcharts": "^1.5.3",
    "vuex": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.1",
    "@quasar/icongenie": "^7.0.0",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.4.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0",
    "npm": ">= 10"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  }
}
